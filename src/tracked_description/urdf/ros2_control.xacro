<?xml version="1.0"?>
<!-- ros2_control donanım arayüzü.
     Controller'lar (tracked_control/config/controllers.yaml) her ortamda aynıdır;
     sadece buradaki hardware plugin'i değişir:
       sim_mode=true            -> gz_ros2_control/GazeboSimSystem   (Gazebo)
       use_mock_hardware=true   -> mock_components/GenericSystem     (donanımsız test)
       aksi halde               -> tracked_hardware/ESP32System      (gerçek robot, UART) -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Palet hızı sınırı 0.6 m/s -> teker hızı sınırı (rad/s) -->
  <xacro:property name="wheel_max_vel" value="${0.6 / wheel_radius}"/>

  <xacro:macro name="wheel_interfaces" params="joint">
    <joint name="${joint}">
      <command_interface name="velocity">
        <param name="min">${-wheel_max_vel}</param>
        <param name="max">${wheel_max_vel}</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <!-- Tahriksiz teker: palet üzerinden dişliyi takip eder (URDF <mimic>), komut arayüzü yok -->
  <xacro:macro name="mimic_wheel_interfaces" params="joint">
    <joint name="${joint}">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="tracked_ros2_control"
               params="sim_mode use_mock_hardware serial_port baudrate">
    <ros2_control name="TrackedUGVSystem" type="system">
      <hardware>
        <xacro:if value="${sim_mode}">
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </xacro:if>
        <xacro:unless value="${sim_mode}">
          <xacro:if value="${use_mock_hardware}">
            <plugin>mock_components/GenericSystem</plugin>
            <param name="calculate_dynamics">true</param>
          </xacro:if>
          <xacro:unless value="${use_mock_hardware}">
            <plugin>tracked_hardware/ESP32System</plugin>
            <param name="serial_port">${serial_port}</param>
            <param name="baudrate">${baudrate}</param>
            <param name="wheel_radius">${wheel_radius}</param>
            <param name="max_track_speed">0.6</param>
            <param name="imu_frame_id">imu_link</param>
            <param name="gps_frame_id">gps_link</param>
          </xacro:unless>
        </xacro:unless>
      </hardware>
      <!-- Tahrik: her yanda arka dişli (gerçek robotta palet başına bir motor) -->
      <xacro:wheel_interfaces joint="left_sprocket_joint"/>
      <xacro:wheel_interfaces joint="right_sprocket_joint"/>
      <!-- Gazebo'da ön/orta tekerleri gz_ros2_control dişliye bağlar (palet etkisi).
           Gerçek robotta/mock'ta gerekmez: RSP mimic açılarını URDF'ten hesaplar. -->
      <xacro:if value="${sim_mode}">
        <xacro:mimic_wheel_interfaces joint="left_wheel_mid_joint"/>
        <xacro:mimic_wheel_interfaces joint="left_wheel_front_joint"/>
        <xacro:mimic_wheel_interfaces joint="right_wheel_mid_joint"/>
        <xacro:mimic_wheel_interfaces joint="right_wheel_front_joint"/>
      </xacro:if>
    </ros2_control>
  </xacro:macro>

</robot>
