<?xml version="1.0"?>
<!-- Gazebo (Harmonic) eklentileri: sürtünme, gz_ros2_control ve sensörler.
     Sadece sim_mode=true iken dahil edilir. Sensör topic'leri ROS tarafına
     tracked_gazebo/config/gz_bridge.yaml ile aktarılır. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="gaussian_noise" params="stddev">
    <noise type="gaussian">
      <mean>0.0</mean>
      <stddev>${stddev}</stddev>
    </noise>
  </xacro:macro>

  <!-- Kamera ve LiDAR SDF'te tipi alt eleman olarak bekler -->
  <xacro:macro name="gaussian_noise_elem" params="stddev">
    <noise>
      <type>gaussian</type>
      <mean>0.0</mean>
      <stddev>${stddev}</stddev>
    </noise>
  </xacro:macro>

  <xacro:macro name="xyz_noise" params="stddev">
    <x><xacro:gaussian_noise stddev="${stddev}"/></x>
    <y><xacro:gaussian_noise stddev="${stddev}"/></y>
    <z><xacro:gaussian_noise stddev="${stddev}"/></z>
  </xacro:macro>

  <xacro:macro name="tracked_gazebo" params="use_lidar">

    <!-- ==================== SÜRTÜNME ==================== -->
    <!-- Palet-zemin teması: yüksek sürtünme; dönüşte paletler yanal kayar (skid-steer) -->
    <xacro:macro name="track_friction" params="link">
      <gazebo reference="${link}">
        <mu1>${track_mu}</mu1>
        <mu2>${track_mu}</mu2>
      </gazebo>
    </xacro:macro>
    <xacro:property name="track_mu" value="1.0"/>
    <xacro:track_friction link="left_sprocket"/>
    <xacro:track_friction link="left_wheel_mid"/>
    <xacro:track_friction link="left_wheel_front"/>
    <xacro:track_friction link="right_sprocket"/>
    <xacro:track_friction link="right_wheel_mid"/>
    <xacro:track_friction link="right_wheel_front"/>

    <!-- ==================== ROS2_CONTROL ==================== -->
    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find tracked_control)/config/controllers.yaml</parameters>
      </plugin>
    </gazebo>

    <!-- ==================== IMU ==================== -->
    <!-- Yönelimli (9-DoF) IMU gibi davranır: orientation ENU, gyro/ivme gürültülü -->
    <gazebo reference="imu_link">
      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>50</update_rate>
        <topic>/imu/data</topic>
        <gz_frame_id>imu_link</gz_frame_id>
        <imu>
          <orientation_reference_frame>
            <localization>ENU</localization>
          </orientation_reference_frame>
          <angular_velocity>
            <xacro:xyz_noise stddev="0.005"/>
          </angular_velocity>
          <linear_acceleration>
            <xacro:xyz_noise stddev="0.02"/>
          </linear_acceleration>
        </imu>
      </sensor>
    </gazebo>

    <!-- ==================== GPS ==================== -->
    <!-- ros_gz_bridge kovaryansı taşımıyor; gps_driver.py doldurup /gps/fix yayınlar -->
    <!-- DİKKAT: gz yatay gürültüyü enlem/boylama DERECE olarak uygular, dikeyi metre.
         0.8 m / 111320 m/derece ~= 7.2e-6 derece (gps_driver horizontal_stddev: 0.8 m) -->
    <gazebo reference="gps_link">
      <sensor name="navsat_sensor" type="navsat">
        <always_on>true</always_on>
        <update_rate>5</update_rate>
        <topic>/gps/fix_raw</topic>
        <gz_frame_id>gps_link</gz_frame_id>
        <navsat>
          <position_sensing>
            <horizontal><xacro:gaussian_noise stddev="7.2e-6"/></horizontal>
            <vertical><xacro:gaussian_noise stddev="1.5"/></vertical>
          </position_sensing>
        </navsat>
      </sensor>
    </gazebo>

    <!-- ==================== KAMERA ==================== -->
    <gazebo reference="camera_link">
      <sensor name="camera_sensor" type="camera">
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <topic>/camera/image_raw</topic>
        <gz_frame_id>camera_link_optical</gz_frame_id>
        <camera>
          <horizontal_fov>1.085</horizontal_fov> <!-- ~62 derece görüş açısı -->
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>20.0</far>
          </clip>
          <xacro:gaussian_noise_elem stddev="0.007"/>
        </camera>
      </sensor>
    </gazebo>

    <!-- ==================== LIDAR (opsiyonel) ==================== -->
    <xacro:if value="${use_lidar}">
      <gazebo reference="lidar_link">
        <sensor name="lidar" type="gpu_lidar">
          <always_on>true</always_on>
          <visualize>true</visualize>
          <update_rate>10</update_rate>
          <topic>/scan</topic>
          <gz_frame_id>lidar_link</gz_frame_id>
          <lidar>
            <scan>
              <horizontal>
                <samples>360</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159</min_angle>
                <max_angle>3.14159</max_angle>
              </horizontal>
            </scan>
            <range>
              <min>0.15</min>
              <max>12.0</max>
              <resolution>0.01</resolution>
            </range>
            <xacro:gaussian_noise_elem stddev="0.01"/>
          </lidar>
        </sensor>
      </gazebo>
    </xacro:if>

  </xacro:macro>

</robot>
