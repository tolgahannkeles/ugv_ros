<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tracked_description</name>
  <version>0.1.0</version>
  <description>URDF (xacro), ros2_control and Gazebo sensor description of the tracked UGV</description>
  <maintainer email="tolgahan.keles@agu.edu.tr">Tolgahan Keleş</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <!-- gazebo.xacro controller config'ini buradan okur -->
  <exec_depend>tracked_control</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
