<?xml version="1.0" ?>
<!-- TEKNOFEST İnsansız Kara Aracı parkuru (PRK26-A-001-001-00).
     Parkur modeli teknofest_parkur/STEP dosyasından tools/parkur_to_gazebo.py ile üretilir.

     Parkur akışı (S yol, üstten alta):
       Üst kol  (y ~ 20) : giriş direği (x -26.5) -> dik eğim -> engebe çubukları
       Orta kol (y ~ 10) : şerit perdeli kapı -> duba slalomu -> dik engel
       Alt kol  (y ~  0) : yan eğim -> taşlı çakıllı yol -> su geçişi
       Ayrı alan (y ~ 30): paralel hız şeritleri
     Robot varsayılan olarak üst kol girişinde doğar (sim.launch.py: x -24.5, y 20). -->
<sdf version="1.9">
  <world name="teknofest_2026">
    <!-- Fizik Ayarları -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Temel Eklentiler -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <!-- IMU ve GPS sensörleri bu sistemler olmadan veri üretmez -->
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>

    <!-- GPS referansı: dünya orijini bu koordinata denk gelir (AGÜ, Kayseri) -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>38.7370</latitude_deg>
      <longitude_deg>35.4730</longitude_deg>
      <elevation>1050</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.8 0.95 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Güneş / Işık -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 30 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.3 -0.9</direction>
    </light>

    <!-- Güvenlik zemini: parkur plakasının (49 x 42 m) dışına çıkan araç düşmesin.
         Görünmez ve plakanın 2 cm altında; parkurun kendi zemini üstte kalır. -->
    <model name="safety_ground">
      <static>true</static>
      <pose>0 0 -0.02 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
        </collision>
      </link>
    </model>

    <!-- TEKNOFEST parkuru -->
    <include>
      <uri>model://teknofest_ika_parkur</uri>
      <name>teknofest_ika_parkur</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

  </world>
</sdf>
