<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tracked_bringup</name>
  <version>0.0.0</version>
  <description>Launch and configurations for tracked robot</description>
  <maintainer email="tolgahan@todo.todo">tolgahan</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  
  <!-- Ortak katmanlar (simülasyonla aynı) -->
  <exec_depend>tracked_description</exec_depend>
  <exec_depend>tracked_control</exec_depend>
  <exec_depend>tracked_localization</exec_depend>
  <exec_depend>tracked_intelligence</exec_depend>
  <exec_depend>ugv_web</exec_depend>
  <!-- Gerçek robota özel -->
  <exec_depend>tracked_hardware</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>imu_filter_madgwick</exec_depend>
  <exec_depend>camera_ros</exec_depend>
  <exec_depend>web_video_server</exec_depend>
  <exec_depend>rosbridge_server</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
