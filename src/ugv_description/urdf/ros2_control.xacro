<?xml version="1.0"?>
<!-- ros2_control donanım arayüzü.
     Controller'lar (ugv_control/config/controllers.yaml) her ortamda aynıdır;
     sadece buradaki hardware plugin'i değişir:
       sim_mode=true            -> gz_ros2_control/GazeboSimSystem   (Gazebo)
       use_mock_hardware=true   -> mock_components/GenericSystem     (donanımsız test)
       aksi halde               -> ugv_hardware/ESP32System      (gerçek robot, UART) -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Palet hızı sınırı -> teker hızı sınırı (rad/s); config/vehicle.yaml drive bölümü
       (dönüşte dış palet ortalamadan hızlı gider, track_speed_margin kadar pay) -->
  <xacro:property name="drive" value="${vehicle['drive']}"/>
  <xacro:property name="wheel_max_vel"
                  value="${drive['max_linear_velocity'] * drive['track_speed_margin'] / wheel_radius}"/>

  <xacro:macro name="wheel_interfaces" params="joint">
    <joint name="${joint}">
      <command_interface name="velocity">
        <param name="min">${-wheel_max_vel}</param>
        <param name="max">${wheel_max_vel}</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <!-- Tahriksiz teker: palet üzerinden dişliyi takip eder (URDF <mimic>), komut arayüzü yok -->
  <xacro:macro name="mimic_wheel_interfaces" params="joint">
    <joint name="${joint}">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="ugv_ros2_control"
               params="sim_mode use_mock_hardware serial_port baudrate">
    <ros2_control name="TrackedUGVSystem" type="system">
      <hardware>
        <xacro:if value="${sim_mode}">
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </xacro:if>
        <xacro:unless value="${sim_mode}">
          <xacro:if value="${use_mock_hardware}">
            <plugin>mock_components/GenericSystem</plugin>
            <param name="calculate_dynamics">true</param>
          </xacro:if>
          <xacro:unless value="${use_mock_hardware}">
            <plugin>ugv_hardware/ESP32System</plugin>
            <param name="serial_port">${serial_port}</param>
            <param name="baudrate">${baudrate}</param>
            <param name="wheel_radius">${wheel_radius}</param>
            <param name="max_track_speed">0.6</param>
            <param name="imu_frame_id">imu_link</param>
            <param name="gps_frame_id">gps_link</param>
          </xacro:unless>
        </xacro:unless>
      </hardware>
      <!-- Tahrik: her yanda arka dişli (gerçek robotta palet başına bir motor) -->
      <xacro:wheel_interfaces joint="left_sprocket_joint"/>
      <xacro:wheel_interfaces joint="right_sprocket_joint"/>
      <!-- Gazebo'da tahriksiz tekerleri gz_ros2_control dişliye bağlar (görselde dönsünler).
           Gerçek robotta/mock'ta gerekmez: RSP mimic açılarını URDF'ten hesaplar. -->
      <xacro:if value="${sim_mode}">
        <xacro:macro name="side_mimics" params="side">
          <xacro:mimic_wheel_interfaces joint="${side}_idler_joint"/>
          <xacro:mimic_wheel_interfaces joint="${side}_road_1_joint"/>
          <xacro:mimic_wheel_interfaces joint="${side}_road_2_joint"/>
          <xacro:mimic_wheel_interfaces joint="${side}_road_3_joint"/>
          <xacro:mimic_wheel_interfaces joint="${side}_road_4_joint"/>
          <xacro:mimic_wheel_interfaces joint="${side}_road_5_joint"/>
          <xacro:mimic_wheel_interfaces joint="${side}_road_6_joint"/>
        </xacro:macro>
        <xacro:side_mimics side="left"/>
        <xacro:side_mimics side="right"/>
      </xacro:if>
    </ros2_control>
  </xacro:macro>

</robot>
